local function addSlider(parent, text, min, max, step, key, cb, dec, allowType)
    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Colors.Surface2,
        BackgroundTransparency = 0.4, BorderSizePixel = 0,
    }, parent)
    corner(card, 8)
    new("TextLabel", {
        Size = UDim2.new(1, -110, 0, 16), Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium,
        TextSize = 11.5, TextColor3 = Colors.Text, TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local val
    if allowType then
        val = new("TextBox", {
            Size = UDim2.fromOffset(56, 18), Position = UDim2.new(1, -12, 0, 3),
            AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Colors.Surface,
            BorderSizePixel = 0, Text = fmt(Config[key], dec), Font = Enum.Font.GothamBold,
            TextSize = 11, TextColor3 = Colors.Text, ClearTextOnFocus = false,
        }, card)
        corner(val, 5)
        val.FocusLost:Connect(function()
            local n = tonumber(val.Text)
            if not n then val.Text = fmt(Config[key], dec) return end
            n = math.clamp(snap(n, min, step), min, max)
            Config[key] = n
            val.Text = fmt(n, dec)
            if cb then cb(n) end
            saveConfig()
        end)
    else
        val = new("TextLabel", {
            Size = UDim2.fromOffset(56, 18), Position = UDim2.new(1, -12, 0, 3),
            AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1,
            Text = fmt(Config[key], dec), Font = Enum.Font.GothamBold, TextSize = 11,
            TextColor3 = accent(), TextXAlignment = Enum.TextXAlignment.Right,
        }, card)
        onTheme(function() val.TextColor3 = accent() end)
    end

    local track = new("Frame", {
        Size = UDim2.new(1, -24, 0, 4), Position = UDim2.new(0, 12, 0, 28),
        BackgroundColor3 = Colors.Surface, BorderSizePixel = 0,
    }, card)
    corner(track, 2)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = accent(), BorderSizePixel = 0 }, track)
    corner(fill, 2)
    onTheme(function() fill.BackgroundColor3 = accent() end)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Colors.Text, BorderSizePixel = 0,
    }, track)
    corner(knob, 5)

    local function render()
        local a = math.clamp((Config[key] - min) / math.max(max - min, 0.0001), 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        if val:IsA("TextBox") then
            if not val:IsFocused() then val.Text = fmt(Config[key], dec) end
        else
            val.Text = fmt(Config[key], dec)
        end
    end
    render()

    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 20),
        BackgroundTransparency = 1, Text = "",
    }, card)
    local dragging = false
    local function setFromX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        local n = math.clamp(snap(min + a * (max - min), min, step), min, max)
        if n ~= Config[key] then
            Config[key] = n
            render()
            if cb then cb(n) end
        end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(i.Position.X)
        end
    end)
    conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end)
    conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            saveConfig()
        end
    end)
    return card
end

