local espCache = {}
local hlCache = {}

local function newESP()
    local o = {}
    o.box = Drawing.new("Square")
    o.box.Thickness = 1.5
    o.box.Filled = false
    o.box.Transparency = 1

    o.name = Drawing.new("Text")
    o.name.Size = 14
    o.name.Font = 2
    o.name.Center = true
    o.name.Outline = true
    o.name.OutlineColor = Color3.new(0, 0, 0)

    o.dist = Drawing.new("Text")
    o.dist.Size = 12
    o.dist.Font = 2
    o.dist.Center = true
    o.dist.Outline = true
    o.dist.OutlineColor = Color3.new(0, 0, 0)
    o.dist.Color = Colors.TextDim

    o.hpBg = Drawing.new("Square")
    o.hpBg.Filled = true
    o.hpBg.Color = Color3.new(0, 0, 0)
    o.hpBg.Transparency = 0.5

    o.hpFill = Drawing.new("Square")
    o.hpFill.Filled = true
    o.hpFill.Transparency = 0.05
    return o
end

local function hideESP(o)
    o.box.Visible = false
    o.name.Visible = false
    o.dist.Visible = false
    o.hpBg.Visible = false
    o.hpFill.Visible = false
end

local function hpColor(r)
    if r > 0.5 then
        return Color3.fromRGB(255, 220, 80):Lerp(Color3.fromRGB(70, 220, 140), (r - 0.5) * 2)
    end
    return Color3.fromRGB(255, 70, 90):Lerp(Color3.fromRGB(255, 220, 80), r * 2)
end

local function charHeight(char)
    local hrp = getRoot(char)
    if not hrp then return 5 end
    local head = char:FindFirstChild("Head")
    if head then
        local h = (head.Position - hrp.Position).Magnitude + 1.2
        if h > 1 then return h end
    end
    return 5
end

local function updateChams(plr, char, enemy)
    local h = hlCache[plr]
    if Config.ESP and Config.ESPChams and char then
        if not h or h.Parent ~= char then
            if h then pcall(function() h:Destroy() end) end
            h = Instance.new("Highlight")
            h.FillTransparency = 0.65
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = char
            h.Parent = char
            hlCache[plr] = h
        end
        local c = enemy and espEnemy() or espAlly()
        h.FillColor = c
        h.OutlineColor = c
    elseif h then
        pcall(function() h:Destroy() end)
        hlCache[plr] = nil
    end
end

local function updateESP()
    if not Drawing then return end
    local camPos = Cam.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local o = espCache[plr]
            if not o then
                o = newESP()
                espCache[plr] = o
            end

            local alive, char, hum = getChar(plr)
            local root = alive and getRoot(char)
            local drawn = false

            if Config.ESP and root then
                local dist = (camPos - root.Position).Magnitude
                if dist <= Config.ESPMax then
                    local half = charHeight(char) / 2
                    local sTop, on1 = Cam:WorldToViewportPoint(root.Position + Vector3.new(0, half, 0))
                    local sBot, on2 = Cam:WorldToViewportPoint(root.Position - Vector3.new(0, half, 0))
                    if on1 and on2 and sTop.Z > 0 then
                        local h = math.max(math.abs(sBot.Y - sTop.Y), 6)
                        local w = math.max(h * 0.55, 8)
                        local x, y = sTop.X - w / 2, math.min(sTop.Y, sBot.Y)
                        local enemy = isEnemy(plr)
                        local col = enemy and espEnemy() or espAlly()

                        o.box.Visible = Config.ESPBox
                        o.box.Color = col
                        o.box.Position = Vector2.new(x, y)
                        o.box.Size = Vector2.new(w, h)

                        o.name.Visible = Config.ESPName
                        o.name.Text = plr.Name
                        o.name.Color = Colors.Text
                        o.name.Position = Vector2.new(x + w / 2, y - 18)

                        o.dist.Visible = Config.ESPDistance
                        o.dist.Text = string.format("%d m", math.floor(dist))
                        o.dist.Position = Vector2.new(x + w / 2, y + h + 2)

                        local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        o.hpBg.Visible = Config.ESPHealth
                        o.hpBg.Position = Vector2.new(x - 5, y)
                        o.hpBg.Size = Vector2.new(2, h)

                        o.hpFill.Visible = Config.ESPHealth
                        o.hpFill.Size = Vector2.new(2, math.max(h * ratio, 1))
                        o.hpFill.Position = Vector2.new(x - 5, y + h * (1 - ratio))
                        o.hpFill.Color = hpColor(ratio)
                        drawn = true
                    end
                end
            end
            if not drawn then hideESP(o) end
            updateChams(plr, alive and char or nil, isEnemy(plr))
        end
    end

    for plr, o in pairs(espCache) do
        if not plr.Parent then
            for _, d in pairs(o) do pcall(function() d:Remove() end) end
            espCache[plr] = nil
            if hlCache[plr] then
                pcall(function() hlCache[plr]:Destroy() end)
                hlCache[plr] = nil
            end
        end
    end
end

--=====================================================================
-- HITBOX (v1.6)
--=====================================================================
local HB = {
    data = {},                             -- char -> estado original
    visuals = {},                          -- char -> Part do cubo
    players = {},                          -- lista de chars de players
    npcs = {},                             -- lista de models NPC
    scanClock = 0,
    vecCache = {},
}

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.MaxParts = 250

local function getVec(n)
    local v = HB.vecCache[n]
    if not v then
        v = Vector3.new(n, n, n)
        HB.vecCache[n] = v
    end
    return v
end

local function makeVisual(char)
    local v = new("Part", {
        Name = "UH_HitboxVisual",
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
        CastShadow = false, Material = Enum.Material.Neon, Transparency = 0.55,
        Size = Vector3.new(1, 1, 1), Color = hbColor(),
    }, WS)
    HB.visuals[char] = v
    return v
end

local function destroyVisual(char)
    local v = HB.visuals[char]
    if v then
        pcall(function() v:Destroy() end)
        HB.visuals[char] = nil
    end
end

local function applyHitbox(char, hrp, size, showCube)
    local d = HB.data[char]
    if not d or d.part ~= hrp then
        d = {
            part = hrp,
            size = hrp.Size,
            transparency = hrp.Transparency,
            collide = hrp.CanCollide,
        }
        HB.data[char] = d
    end

    local vec = getVec(size)
    if hrp.Size ~= vec then hrp.Size = vec end
    if hrp.CanCollide then hrp.CanCollide = false end

    local v = HB.visuals[char]
    if showCube then
        if not v or not v.Parent then v = makeVisual(char) end
        if v.Size ~= vec then v.Size = vec end
        v.Color = hbColor()
        v.Transparency = 0.55
        v.CFrame = CFrame.new(hrp.Position)   -- sempre colado no alvo, eixo-alinhado
    elseif v then
        v.Transparency = 1
    end
end

local function restoreHitbox(char)
    local d = HB.data[char]
    if d and d.part and d.part.Parent then
        local p = d.part
        pcall(function()
            p.Size = d.size
            p.Transparency = d.transparency
            p.CanCollide = d.collide
        end)
    end
    HB.data[char] = nil
    destroyVisual(char)
end

local function restoreAll()
    for char in pairs(HB.data) do restoreHitbox(char) end
    HB.data = {}
    for char in pairs(HB.visuals) do destroyVisual(char) end
    HB.visuals = {}
end
getgenv().UnknownHub_RestoreHitboxes = function() restoreAll(); notify("Hitboxes restauradas") end

local function refreshPlayerChars()
    local list, set = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            list[#list + 1] = plr.Character
            set[plr.Character] = true
        end
    end
    HB.players = list
    return set
end

local function scanNPCs()
    local char = LP.Character
    local root = char and getRoot(char)
    if not root then
        HB.npcs = {}
        return
    end
    overlapParams.FilterDescendantsInstances = { char }
    local r = Config.HitboxMaxDist
    local parts = WS:GetPartBoundsInBox(CFrame.new(root.Position), Vector3.new(r * 2, 320, r * 2), overlapParams)
    local seen, list = {}, {}
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and not seen[model] then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(model) == nil then
                seen[model] = true
                list[#list + 1] = model
            end
        end
    end
    HB.npcs = list
end

conns[#conns + 1] = RS.Heartbeat:Connect(function(dt)
    if not Config.Hitbox then
        if next(HB.data) then restoreAll() end
        HB.npcs = {}
        HB.scanClock = 0
        return
    end

    local myChar = LP.Character
    local myRoot = myChar and getRoot(myChar)
    if not myRoot then return end
    local myPos = myRoot.Position
    local maxD = Config.HitboxMaxDist
    local showCube = Config.HitboxVisual
    local playerSet = refreshPlayerChars()

    -- players: aplica dentro do alcance, restaura quem saiu (corrige o cubo congelado)
    if Config.HitboxPlayers then
        for _, char in ipairs(HB.players) do
            if char ~= myChar then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = hum and hum.Health > 0 and getRoot(char)
                if root then
                    local dist = (root.Position - myPos).Magnitude
                    if dist <= maxD then
                        pcall(applyHitbox, char, root, Config.HitboxPlayerSize, showCube)
                    elseif HB.data[char] then
                        pcall(restoreHitbox, char)
                    end
                elseif HB.data[char] then
                    pcall(restoreHitbox, char)
                end
            end
        end
    else
        for _, char in ipairs(HB.players) do
            if HB.data[char] then pcall(restoreHitbox, char) end
        end
    end

    -- NPCs: rescan controlado + aplicação
    if Config.HitboxNPCs then
        HB.scanClock = HB.scanClock + dt
        if HB.scanClock >= 2 then
            HB.scanClock = 0
            pcall(scanNPCs)
        end
        for _, model in ipairs(HB.npcs) do
            if model.Parent and not playerSet[model] then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local root = hum and hum.Health > 0 and getRoot(model)
                if root then
                    pcall(applyHitbox, model, root, Config.HitboxNPCSize, showCube)
                elseif HB.data[model] then
                    pcall(restoreHitbox, model)
                end
            elseif HB.data[model] then
                pcall(restoreHitbox, model)
            end
        end
        for model in pairs(HB.data) do
            if not playerSet[model] and not model.Parent then
                HB.data[model] = nil
                destroyVisual(model)
            end
        end
    else
        for model in pairs(HB.data) do
            if not playerSet[model] then pcall(restoreHitbox, model) end
        end
        HB.npcs = {}
    end

    -- limpeza de quem morreu/saiu
    for char in pairs(HB.data) do
        if not char.Parent then
            HB.data[char] = nil
            destroyVisual(char)
        end
    end
end)

