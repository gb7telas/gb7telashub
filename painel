local speedOrig, speedHum, speedActive = nil, nil, false

local function speedStep()
    local hum = getLocalHumanoid()
    if not hum then
        speedOrig, speedHum, speedActive = nil, nil, false
        return
    end
    if hum ~= speedHum then
        speedHum = hum
        speedOrig = hum.WalkSpeed
        speedActive = false
    end
    local active = Config.Speed and (not Config.SpeedHold or State.speedKeyDown)
    if active then
        if hum.WalkSpeed ~= Config.SpeedValue then hum.WalkSpeed = Config.SpeedValue end
        speedActive = true
    elseif speedActive then
        hum.WalkSpeed = speedOrig or 16
        speedActive = false
    end
end

