        Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order or index,
        BackgroundColor3 = Colors.Surface, Text = name, TextColor3 = Colors.TextDim,
        Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false,
        BorderSizePixel = 0, ZIndex = 2,
    }, sidebar)
    corner(btn, 7)
    local ind = create("Frame", {
        Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 0, 0.5, -8),
        BackgroundColor3 = accent(), BorderSizePixel = 0, Visible = false, ZIndex = 3,
    }, btn)
    corner(ind, 2)
    theme.bgs[#theme.bgs + 1] = ind
    tabs[index] = { btn = btn, ind = ind }
end

local function selectTab(index)
    for i, t in ipairs(tabs) do
        local active = (i == index)
        t.btn.BackgroundColor3 = active and Colors.Surface2 or Colors.Surface
        t.btn.TextColor3 = active and Colors.Text or Colors.TextDim
        t.ind.Visible = active
    end
    for i, p in ipairs(pages) do
        p.Visible = (i == index)
    end
end

