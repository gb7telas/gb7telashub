local CFG_FILE = "UnknownHub_Config.json"
local KEY_FIELDS = { "AimKey", "SpeedKey", "ToggleKey" }

local function saveConfig()
    if not writefile then return end
    local data = {}
    for k, v in pairs(Config) do
        if typeof(v) == "EnumItem" then
            data[k] = v.Name
        elseif typeof(v) == "Color3" then
            data[k] = { math.floor(v.R * 255), math.floor(v.G * 255), math.floor(v.B * 255) }
        else
            data[k] = v
        end
    end
    pcall(function() writefile(CFG_FILE, HS:JSONEncode(data)) end)
end

local function loadConfig()
    if not (isfile and readfile) then return end
    if not isfile(CFG_FILE) then return end
    local ok, data = pcall(function() return HS:JSONDecode(readfile(CFG_FILE)) end)
    if not ok or type(data) ~= "table" then return end
    for k, v in pairs(data) do
        if Config[k] ~= nil then
            if k == "AimKey" or k == "SpeedKey" or k == "ToggleKey" then
                local kc = Enum.KeyCode[v]
                if kc then Config[k] = kc end
            elseif type(v) == type(Config[k]) then
                Config[k] = v
            end
        end
    end
end
