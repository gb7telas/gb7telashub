-- COMBAT FRAMEWORK
--=====================================================================
local combatCtrl, combatTick = nil, 0

local COOLDOWN_KEYS = { "attackCooldown", "coolDown", "cooldown", "attackCoolDown", "AttackCoolDown" }

local function looksLikeController(t)
    local keys = {}
    for k in pairs(t) do keys[#keys + 1] = tostring(k):lower() end
    local sig = table.concat(keys, ",")
    return sig:find("attack") ~= nil or sig:find("hitbox") ~= nil or sig:find("combat") ~= nil
end

local function findCombatController()
    local ps = LP:FindFirstChild("PlayerScripts")
    local folder = ps and ps:FindFirstChild("CombatFramework")
    if not folder then return nil end
    local ok, mod = pcall(require, folder)
    if not ok or type(mod) ~= "table" then return nil end
    for _, getUV in ipairs({ debug.getupvalues, getupvalues }) do
        if getUV then
            local okUV, ups = pcall(getUV, mod)
            if okUV and type(ups) == "table" then
                for _, v in pairs(ups) do
                    if type(v) == "table" then
                        if looksLikeController(v) then return v end
                        for _, k in ipairs({ "activeController", "controller" }) do
                            if type(v[k]) == "table" and looksLikeController(v[k]) then return v[k] end
                        end
                    end
                end
            end
        end
    end
    return type(mod.activeController) == "table" and mod.activeController or nil
end

conns[#conns + 1] = RS.Heartbeat:Connect(function(dt)
    if not (Config.FastAttack or Config.MeleeReach > 0) then
        combatCtrl = nil
        return
    end
    if not combatCtrl then
        combatTick = combatTick + dt
        if combatTick < 2 then return end
        combatTick = 0
        combatCtrl = findCombatController()
        if not combatCtrl then return end
    end
    pcall(function()
        local c = combatCtrl
        if Config.FastAttack then
            for _, k in ipairs(COOLDOWN_KEYS) do
                if c[k] ~= nil and c[k] ~= Config.FastCooldown then c[k] = Config.FastCooldown end
            end
            if type(c.data) == "table" then
                for _, k in ipairs(COOLDOWN_KEYS) do
                    if c.data[k] ~= nil then c.data[k] = Config.FastCooldown end
                end
            end
        end
        if Config.MeleeReach > 0 and c.hitboxMagnitude ~= nil then
            c.hitboxMagnitude = Config.MeleeReach
        end
    end)
end)

