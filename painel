    noclipStep()
end)

--=====================================================================
-- HITBOX LOOP (Heartbeat, todo frame)
--=====================================================================
conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
    if not Config.Hitbox then
        for char in pairs(hitboxCache) do
            restoreHitbox(char)
        end
        for model in pairs(visualCache) do
            hideVisual(model)
        end
        npcList = {}
        npcScanTimer = 0
        return
    end

    refreshPlayerChars()

    -- players
    for _, plr in ipairs(Players:GetPlayers()) do
        if Config.HitboxLocal or plr ~= LP then
            local alive, char, hum = getChar(plr)
            if alive then
                pcall(applyHitbox, char, Config.HitboxSize)
            end
        end
    end

    -- NPCs (rescan periódico, aplicação todo frame)
    if Config.HitboxNPCs then
        npcScanTimer = npcScanTimer + dt
        if npcScanTimer >= NPC_SCAN_INTERVAL then
            npcScanTimer = 0
            pcall(scanNPCs)
        end
        for _, npc in ipairs(npcList) do
            if npc.Parent then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    pcall(applyHitbox, npc, Config.HitboxSize)
                end
            end
        end
    end

    -- limpa caches de modelos removidos
    for char in pairs(hitboxCache) do
        if not char.Parent then
            hitboxCache[char] = nil
            hideVisual(char)
        end
    end

    -- remove cubos de modelos que sumiram
    for model in pairs(visualCache) do
        if not hitboxCache[model] then
            hideVisual(model)
        end
    end
end)

--=====================================================================
-- SPEED
--=====================================================================
local speedOrig, speedHumanoid, speedActive = nil, nil, false

local function getLocalHumanoid()
    local char = LP.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function speedStep()
    local hum = getLocalHumanoid()
    if not hum then
        speedOrig, speedHumanoid, speedActive = nil, nil, false
        return
    end

    if hum ~= speedHumanoid then
        speedHumanoid = hum
        speedOrig = hum.WalkSpeed
        speedActive = false
    end

    local active = Config.Speed and (not Config.SpeedHold or State.speedKeyDown)

    if active then
        if hum.WalkSpeed ~= Config.SpeedValue then
            hum.WalkSpeed = Config.SpeedValue
        end
        speedActive = true
    elseif speedActive then
        hum.WalkSpeed = speedOrig or 16
        speedActive = false
    end
end

conns[#conns + 1] = LP.CharacterAdded:Connect(function()
    speedOrig, speedHumanoid, speedActive = nil, nil, false
end)

--=====================================================================
-- INPUT
--=====================================================================
conns[#conns + 1] = UIS.InputBegan:Connect(function(input, gpe)
    if State.listeningKey then return end

    if input.KeyCode == Config.AimKey then
        if Config.AimToggleMode then
            State.aimToggled = not State.aimToggled
        else
            State.keyDown = true
        end
    end

    if Config.AimMouse and input.UserInputType == Enum.UserInputType.MouseButton2 then
        State.mouseDown = true
    end

    if input.KeyCode == Config.SpeedKey then
        State.speedKeyDown = true
    end

    if input.KeyCode == Config.UIToggleKey and not gpe then
        toggleUI()
    end
end)

conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Config.AimKey then
        State.keyDown = false
    end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        State.mouseDown = false
    end
    if input.KeyCode == Config.SpeedKey then
        State.speedKeyDown = false
    end
end)

conns[#conns + 1] = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if Workspace.CurrentCamera then
        Camera = Workspace.CurrentCamera
    end
end)

--=====================================================================
-- LOOP PRINCIPAL
--=====================================================================
local function isAiming()
    if not Config.Aimbot then return false end
    if Config.AimToggleMode then return State.aimToggled end
    if State.keyDown then return true end
    if Config.AimMouse and State.mouseDown then return true end
    return false
end

conns[#conns + 1] = RunService.RenderStepped:Connect(function(dt)
    -- círculo do FOV
    if fovCircle then
        local show = Config.Aimbot and Config.ShowFOV
        fovCircle.Visible = show
        fovDot.Visible = show
        if show then
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            fovCircle.Position = center
            fovCircle.Radius = Config.FOV
            fovDot.Position = center
        end
    end

    -- ESP
    if Drawing then
        pcall(updateESP)
    end

    -- Speed
    speedStep()

    -- Aimbot
    if isAiming() then
        local target = findTarget()
        if target then
            aimAt(target, dt)
        end
    end
end)

--=====================================================================
-- LIMPEZA / SHUTDOWN
--=====================================================================
getgenv().UnknownHub_Cleanup = function()
    getgenv().UnknownHub_Alive = false

    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}

    for _, o in pairs(espCache) do
        for _, d in pairs(o) do
            pcall(function() d:Remove() end)
            pcall(function() d:Destroy() end)
        end
    end
    espCache = {}

    for _, h in pairs(hlCache) do
        pcall(function() h:Destroy() end)
    end
    hlCache = {}

    for model in pairs(visualCache) do
        pcall(hideVisual, model)
    end
    visualCache = {}

    for char in pairs(hitboxCache) do
        pcall(restoreHitbox, char)
    end
    hitboxCache = {}

    for part in pairs(noclipCache) do
        if part and part.Parent then
            pcall(function() part.CanCollide = true end)
        end
    end
    noclipCache = {}

    pcall(function()
        local hum = getLocalHumanoid()
        if hum and speedOrig then hum.WalkSpeed = speedOrig end
    end)

    pcall(function() if fovCircle then fovCircle:Remove() end end)
    pcall(function() if fovDot then fovDot:Remove() end end)

    pcall(function() gui:Destroy() end)
end

