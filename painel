local espCache  = {}
local hlCache   = {}
local boundsCache = setmetatable({}, { __mode = "k" })

local function getOffsets(char)
    local c = boundsCache[char]
    if c then return c[1], c[2] end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return 2.5, -3 end
    local minY, maxY = math.huge, -math.huge
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d ~= root and d.Transparency < 0.95 then
            local y = d.Position.Y
            minY = math.min(minY, y - d.Size.Y / 2)
            maxY = math.max(maxY, y + d.Size.Y / 2)
        end
    end
    if minY == math.huge then return 2.5, -3 end
    local top = math.clamp(maxY - root.Position.Y, 1, 8)
    local bottom = math.clamp(minY - root.Position.Y, -8, -1)
    boundsCache[char] = { top, bottom }
    return top, bottom
end

local function newESP()
    local o = {}
    o.box = Drawing.new("Square")
    o.box.Thickness = 1.5
    o.box.Filled = false
    o.box.Transparency = 1

    o.name = Drawing.new("Text")
    o.name.Size = 14
    o.name.Font = 2
    o.name.Center = true
    o.name.Outline = true
    o.name.OutlineColor = Color3.new(0, 0, 0)
    o.name.Transparency = 1

    o.dist = Drawing.new("Text")
    o.dist.Size = 12
    o.dist.Font = 2
    o.dist.Center = true
    o.dist.Outline = true
    o.dist.OutlineColor = Color3.new(0, 0, 0)
    o.dist.Color = Colors.TextDim
    o.dist.Transparency = 1

    o.hpBg = Drawing.new("Square")
    o.hpBg.Filled = true
    o.hpBg.Color = Color3.new(0, 0, 0)
    o.hpBg.Transparency = 0.55

    o.hpFill = Drawing.new("Square")
    o.hpFill.Filled = true
    o.hpFill.Transparency = 0.1
    return o
end

local function hideESP(o)
    o.box.Visible = false
    o.name.Visible = false
    o.dist.Visible = false
    o.hpBg.Visible = false
    o.hpFill.Visible = false
end

local function hpColor(r)
    if r > 0.5 then
        return Color3.fromRGB(255, 220, 80):Lerp(Color3.fromRGB(70, 220, 140), (r - 0.5) * 2)
    end
    return Color3.fromRGB(255, 70, 90):Lerp(Color3.fromRGB(255, 220, 80), r * 2)
end

local function updateChams(plr, char, enemy)
    local h = hlCache[plr]
    if Config.ESP and Config.ESPChams and char then
        if not h or h.Parent ~= char then
            if h then pcall(function() h:Destroy() end) end
            h = Instance.new("Highlight")
            h.FillTransparency = 0.65
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = char
            h.Parent = char
            hlCache[plr] = h
        end
        local c = enemy and espEnemy() or espAlly()
        h.FillColor = c
        h.OutlineColor = c
    elseif h then
        pcall(function() h:Destroy() end)
        hlCache[plr] = nil
    end
end

local function updateESP()
    local camPos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local o = espCache[plr]
        if not o then
            o = newESP()
            espCache[plr] = o
        end

        local alive, char, hum = getChar(plr)
        local root = alive and char:FindFirstChild("HumanoidRootPart")
        local drawn = false

        if Config.ESP and root then
            local dist = (camPos - root.Position).Magnitude
            if dist <= Config.ESPMaxDistance then
                local topOff, botOff = getOffsets(char)
                local sTop, on1 = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, topOff, 0))
                local sBot, on2 = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, botOff, 0))

                if on1 and on2 and sTop.Z > 0 then
                    local h = math.abs(sBot.Y - sTop.Y)
                    local w = math.max(h * 0.55, 8)
                    local x = sTop.X - w / 2
                    local y = sTop.Y
                    local enemy = isEnemy(plr)
                    local outline = enemy and espEnemy() or espAlly()

                    o.box.Visible = Config.ESPBox
                    o.box.Color = outline
                    o.box.Position = Vector2.new(x, y)
                    o.box.Size = Vector2.new(w, h)

                    o.name.Visible = Config.ESPName
                    o.name.Text = plr.Name
                    o.name.Color = Colors.Text
                    o.name.Position = Vector2.new(sTop.X, y - 17)

                    o.dist.Visible = Config.ESPDistance
                    o.dist.Text = string.format("%d m", math.floor(dist))
                    o.dist.Position = Vector2.new(sTop.X, y + h + 3)

                    local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    o.hpBg.Visible = Config.ESPHealth
                    o.hpBg.Position = Vector2.new(x - 5, y)
                    o.hpBg.Size = Vector2.new(2, h)

                    o.hpFill.Visible = Config.ESPHealth
                    o.hpFill.Size = Vector2.new(2, h * ratio)
                    o.hpFill.Position = Vector2.new(x - 5, y + h * (1 - ratio))
                    o.hpFill.Color = hpColor(ratio)

                    drawn = true
                end
            end
        end

        if not drawn then hideESP(o) end
        updateChams(plr, alive and char or nil, isEnemy(plr))
    end

    for plr, o in pairs(espCache) do
        if not plr.Parent then
            for _, d in pairs(o) do pcall(function() d:Remove() end) end
            espCache[plr] = nil
            if hlCache[plr] then
                pcall(function() hlCache[plr]:Destroy() end)
                hlCache[plr] = nil
            end
        end
    end
end

--=====================================================================
-- HITBOX OTIMIZADA
--=====================================================================
local hitboxCache = {}
local visualCache = {}
local playerCharSet = setmetatable({}, { __mode = "k" })
local npcList = {}
local npcScanTimer = 0
local NPC_SCAN_INTERVAL = 2.0
local sizeVecCache = {}

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.MaxParts = 250

local function getSizedVector(s)
    local v = sizeVecCache[s]
    if not v then
        v = Vector3.new(s, s, s)
        sizeVecCache[s] = v
    end
    return v
end

local function getRoot(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.RootPart then return hum.RootPart end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function getVisual(model)
    local v = visualCache[model]
    if not v or not v.Parent then
        v = Instance.new("Part")
        v.Name = "UH_HitboxVisual"
        v.Anchored = true
        v.CanCollide = false
        v.CanQuery = false
        v.CanTouch = false
        v.CastShadow = false
        v.Material = Enum.Material.Neon
        v.Transparency = 0.6
        v.Size = Vector3.new(1, 1, 1)
        v.Parent = Workspace
        visualCache[model] = v
    end
    return v
end

local function hideVisual(model)
    local v = visualCache[model]
    if v then
        pcall(function() v:Destroy() end)
        visualCache[model] = nil
    end
end

-- aplica hitbox escrevendo só o que mudou (menos propriedades por frame)
local function applyHitbox(char, size, rootPos)
    local hrp = getRoot(char)
    if not hrp then return end

    local cached = hitboxCache[char]
    if not cached or cached.part ~= hrp then
        hitboxCache[char] = {
            part = hrp,
            size = hrp.Size,
            transparency = hrp.Transparency,
            canCollide = hrp.CanCollide,
        }
    end

    local target = getSizedVector(size)
    if hrp.Size ~= target then hrp.Size = target end
    if hrp.CanCollide then hrp.CanCollide = false end
    if hrp.Transparency ~= 1 then hrp.Transparency = 1 end

    if Config.HitboxVisual then
        local v = getVisual(char)
        if v.Size ~= target then
            v.Size = target
            v.Color = hbColor()
        else
            v.Color = hbColor()
        end
        v.CFrame = hrp.CFrame
    elseif visualCache[char] then
        hideVisual(char)
    end
end

local function restoreHitbox(char)
    local c = hitboxCache[char]
    if not c then return end
    local p = c.part
    if p and p.Parent then
        p.Size = c.size
        p.Transparency = c.transparency
        p.CanCollide = c.canCollide
    end
    hitboxCache[char] = nil
    hideVisual(char)
end

-- scan rápido por bounding box (não varre o Workspace inteiro)
local function scanNPCs()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        npcList = {}
        return
    end

    overlapParams.FilterDescendantsInstances = { char }
    local r = Config.HitboxMaxDistance
    local parts = Workspace:GetPartBoundsInBox(
        CFrame.new(root.Position),
        Vector3.new(r * 2, 300, r * 2),
        overlapParams
    )

    local seen, list = {}, {}
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and not seen[model] and not playerCharSet[model] then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                seen[model] = true
                list[#list + 1] = model
            end
        end
    end
    npcList = list
end

local function refreshPlayerChars()
    local set = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then set[plr.Character] = true end
    end
    playerCharSet = set
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
    if not Config.Hitbox then
        if next(hitboxCache) then
            for char in pairs(hitboxCache) do restoreHitbox(char) end
        end
        if next(visualCache) then
            for model in pairs(visualCache) do hideVisual(model) end
        end
        npcList = {}
        npcScanTimer = 0
        return
    end

    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    local maxD = Config.HitboxMaxDistance

    refreshPlayerChars()

    -- players próximos
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP or Config.HitboxLocal then
            local alive, char = getChar(plr)
            if alive then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - myPos).Magnitude <= maxD then
                    pcall(applyHitbox, char, Config.HitboxSize, root.Position)
                end
            end
        end
    end

    -- NPCs: rescan cada 2s + aplicação nos já encontrados
    if Config.HitboxNPCs then
        npcScanTimer = npcScanTimer + dt
        if npcScanTimer >= NPC_SCAN_INTERVAL then
            npcScanTimer = 0
            pcall(scanNPCs)
        end
        for _, npc in ipairs(npcList) do
            if npc.Parent then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    pcall(applyHitbox, npc, Config.HitboxSize)
                end
            end
        end
    elseif next(npcList) then
        npcList = {}
    end

    -- limpeza preguiçosa (só quando necessário)
    if next(hitboxCache) then
        for char in pairs(hitboxCache) do
            if not char.Parent then
                hitboxCache[char] = nil
                hideVisual(char)
            end
        end
    end
    if next(visualCache) then
        for model in pairs(visualCache) do
            if not hitboxCache[model] then hideVisual(model) end
        end
    end
end)

--=====================================================================
-- COMBAT FRAMEWORK
--=====================================================================
local combatCtrl, combatFound, combatRetry = nil, false, 0

local COMBAT_COOLDOWN_KEYS = { "attackCooldown", "coolDown", "cooldown", "attackCoolDown", "AttackCoolDown" }
local COMBAT_ACTIVE_KEYS   = { "activeController", "controller", "self" }

local function tableSignature(t)
    local keys = {}
    for k in pairs(t) do keys[#keys + 1] = tostring(k) end
    table.sort(keys)
    return table.concat(keys, ","):lower()
end

local function looksLikeCombatController(t)
    local sig = tableSignature(t)
    return sig:find("attack") ~= nil or sig:find("hitbox") ~= nil
        or sig:find("combat") ~= nil or sig:find("weapon") ~= nil
end

local function findCombatController()
    local ps = LP:FindFirstChild("PlayerScripts")
    if not ps then return nil end
    local folder = ps:FindFirstChild("CombatFramework")
    if not folder then return nil end
    local ok, mod = pcall(require, folder)
    if not ok or type(mod) ~= "table" then return nil end

    for _, getUV in ipairs({ debug.getupvalues, getupvalues }) do
        if getUV then
            local okUV, upvals = pcall(getUV, mod)
            if okUV and type(upvals) == "table" then
                for _, v in pairs(upvals) do
                    if type(v) == "table" then
                        if looksLikeCombatController(v) then return v end
                        for _, key in ipairs(COMBAT_ACTIVE_KEYS) do
                            local inner = v[key]
                            if type(inner) == "table" and looksLikeCombatController(inner) then
                                return inner
                            end
                        end
                    end
                end
            end
        end
    end
    if type(mod.activeController) == "table" then return mod.activeController end
    return nil
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
    if not Config.FastAttack then
        combatCtrl, combatFound = nil, false
        return
    end

    if not combatFound then
        combatRetry = combatRetry + dt
        if combatRetry >= 2 then
            combatRetry = 0
            combatCtrl = findCombatController()
            combatFound = combatCtrl ~= nil
        end
        if not combatCtrl then return end
    end

    pcall(function()
        local ctrl = combatCtrl
        if not ctrl then return end
        for _, key in ipairs(COMBAT_COOLDOWN_KEYS) do
            if ctrl[key] ~= nil and ctrl[key] ~= Config.FastCooldown then
                ctrl[key] = Config.FastCooldown
            end
        end
        if Config.CombatHitbox > 0 and ctrl.hitboxMagnitude ~= nil then
            ctrl.hitboxMagnitude = Config.CombatHitbox
        end
        if type(ctrl.data) == "table" then
            for _, key in ipairs(COMBAT_COOLDOWN_KEYS) do
                if ctrl.data[key] ~= nil then ctrl.data[key] = Config.FastCooldown end
            end
        end
    end)
end)

