        Visible = false,
        ZIndex = 20,
    }, gui)
    corner(popup, 8)
    stroke(popup, Colors.Stroke)
    local pl = Instance.new("UIListLayout")
    pl.Padding = UDim.new(0, 2)
    pl.Parent = popup
    local pp = Instance.new("UIPadding")
    pp.PaddingTop = UDim.new(0, 4)
    pp.PaddingLeft = UDim.new(0, 4)
    pp.PaddingRight = UDim.new(0, 4)
    pp.Parent = popup

    local current = default
    local api = {}

    local function closePopup()
        popup.Visible = false
        if openPopup == popup then openPopup = nil end
    end

    for _, opt in ipairs(options) do
        local ob = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundColor3 = Colors.Surface,
            Text = opt,
            TextColor3 = Colors.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            AutoButtonColor = false,
        }, popup)
        corner(ob, 5)
        ob.MouseEnter:Connect(function() tween(ob, { BackgroundColor3 = Colors.Surface2 }, 0.12) end)
        ob.MouseLeave:Connect(function() tween(ob, { BackgroundColor3 = Colors.Surface }, 0.12) end)
        ob.MouseButton1Click:Connect(function()
            current = opt
            btn.Text = opt
            closePopup()
            if changed then changed(opt) end
        end)
    end

    btn.MouseButton1Click:Connect(function()
        if popup.Visible then
            closePopup()
        else
            if openPopup and openPopup ~= popup then openPopup.Visible = false end
            popup.Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4)
            popup.Visible = true
            openPopup = popup
        end
    end)

    function api.Set(v, fire)
        current = v
        btn.Text = v
        if fire ~= false and changed then changed(v) end
    end
    function api.Get() return current end
    if key then Refs[key] = api end

    row.MouseEnter:Connect(function() tween(row, { BackgroundColor3 = Colors.Surface2 }, 0.15) end)
    row.MouseLeave:Connect(function() tween(row, { BackgroundColor3 = Colors.Surface }, 0.15) end)
    return api
end

