getgenv().UnknownHub_Cleanup = function()
    getgenv().UnknownHub_Alive = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}

    for _, o in pairs(espCache) do
        for _, d in pairs(o) do
            pcall(function() d:Remove() end)
            pcall(function() d:Destroy() end)
        end
    end
    espCache = {}

    for _, h in pairs(hlCache) do pcall(function() h:Destroy() end) end
    hlCache = {}

    for model in pairs(visualCache) do pcall(hideVisual, model) end
    visualCache = {}

    for char in pairs(hitboxCache) do pcall(restoreHitbox, char) end
    hitboxCache = {}

    for part in pairs(noclipCache) do
        if part and part.Parent then pcall(function() part.CanCollide = true end) end
    end
    noclipCache = {}

    pcall(function()
        local hum = getLocalHumanoid()
        if hum and speedOrig then hum.WalkSpeed = speedOrig end
    end)

    combatCtrl, combatFound = nil, false

    pcall(function() if fovCircle then fovCircle:Remove() end end)
    pcall(function() if fovDot then fovDot:Remove() end end)
    pcall(function() gui:Destroy() end)
end

