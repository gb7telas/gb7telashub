--=====================================================================
-- ESP
--=====================================================================
local espCache  = {}
local hlCache   = {}
local boundsCache = setmetatable({}, { __mode = "k" })

local function getOffsets(char)
    local c = boundsCache[char]
    if c then return c[1], c[2] end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return 2.5, -3 end
    local minY, maxY = math.huge, -math.huge
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d ~= root and d.Transparency < 0.95 then
            local y = d.Position.Y
            minY = math.min(minY, y - d.Size.Y / 2)
            maxY = math.max(maxY, y + d.Size.Y / 2)
        end
    end
    if minY == math.huge then return 2.5, -3 end
    local top = math.clamp(maxY - root.Position.Y, 1, 8)
    local bottom = math.clamp(minY - root.Position.Y, -8, -1)
    boundsCache[char] = { top, bottom }
    return top, bottom
end

local function newESP()
    local o = {}
    o.box = Drawing.new("Square")
    o.box.Thickness = 1.5
    o.box.Filled = false
    o.box.Transparency = 1

    o.name = Drawing.new("Text")
    o.name.Size = 14
    o.name.Font = 2
    o.name.Center = true
    o.name.Outline = true
    o.name.OutlineColor = Color3.new(0, 0, 0)
    o.name.Transparency = 1

    o.dist = Drawing.new("Text")
    o.dist.Size = 12
    o.dist.Font = 2
    o.dist.Center = true
    o.dist.Outline = true
    o.dist.OutlineColor = Color3.new(0, 0, 0)
    o.dist.Color = Colors.TextDim
    o.dist.Transparency = 1

    o.hpBg = Drawing.new("Square")
    o.hpBg.Filled = true
    o.hpBg.Color = Color3.new(0, 0, 0)
    o.hpBg.Transparency = 0.55

    o.hpFill = Drawing.new("Square")
    o.hpFill.Filled = true
    o.hpFill.Transparency = 0.1
    return o
end

local function hideESP(o)
    o.box.Visible = false
    o.name.Visible = false
    o.dist.Visible = false
    o.hpBg.Visible = false
    o.hpFill.Visible = false
end

local function hpColor(r)
    if r > 0.5 then
        return Color3.fromRGB(255, 220, 80):Lerp(Color3.fromRGB(70, 220, 140), (r - 0.5) * 2)
    end
    return Color3.fromRGB(255, 70, 90):Lerp(Color3.fromRGB(255, 220, 80), r * 2)
end

local function updateChams(plr, char, enemy)
    local h = hlCache[plr]
    if Config.ESP and Config.ESPChams and char then
        if not h or h.Parent ~= char then
            if h then pcall(function() h:Destroy() end) end
            h = Instance.new("Highlight")
            h.FillTransparency = 0.65
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = char
            h.Parent = char
            hlCache[plr] = h
        end
        local c = enemy and Color3.fromRGB(255, 80, 100) or Color3.fromRGB(90, 220, 255)
        h.FillColor = c
        h.OutlineColor = c
    elseif h then
        pcall(function() h:Destroy() end)
        hlCache[plr] = nil
    end
end

local function updateESP()
    local camPos = Camera.CFrame.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local o = espCache[plr]
        if not o then
            o = newESP()
            espCache[plr] = o
        end

        local alive, char, hum = getChar(plr)
        local root = alive and char:FindFirstChild("HumanoidRootPart")
        local drawn = false

        if Config.ESP and root then
            local dist = (camPos - root.Position).Magnitude
            if dist <= Config.ESPMaxDistance then
                local topOff, botOff = getOffsets(char)
                local topPoint = root.Position + Vector3.new(0, topOff, 0)
                local botPoint = root.Position + Vector3.new(0, botOff, 0)
                local sTop, on1 = Camera:WorldToViewportPoint(topPoint)
                local sBot, on2 = Camera:WorldToViewportPoint(botPoint)

                if on1 and on2 and sTop.Z > 0 then
                    local h = math.abs(sBot.Y - sTop.Y)
                    local w = math.max(h * 0.55, 8)
                    local x = sTop.X - w / 2
                    local y = sTop.Y
                    local enemy = isEnemy(plr)
                    local outline = enemy and Color3.fromRGB(255, 80, 100) or Color3.fromRGB(90, 220, 255)

                    o.box.Visible = Config.ESPBox
                    o.box.Color = outline
                    o.box.Position = Vector2.new(x, y)
                    o.box.Size = Vector2.new(w, h)

                    o.name.Visible = Config.ESPName
                    o.name.Text = plr.Name
                    o.name.Color = Colors.Text
                    o.name.Position = Vector2.new(sTop.X, y - 17)

                    o.dist.Visible = Config.ESPDistance
                    o.dist.Text = string.format("%d m", math.floor(dist))
                    o.dist.Position = Vector2.new(sTop.X, y + h + 3)

                    local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    o.hpBg.Visible = Config.ESPHealth
                    o.hpBg.Position = Vector2.new(x - 5, y)
                    o.hpBg.Size = Vector2.new(2, h)

                    o.hpFill.Visible = Config.ESPHealth
                    o.hpFill.Size = Vector2.new(2, h * ratio)
                    o.hpFill.Position = Vector2.new(x - 5, y + h * (1 - ratio))
                    o.hpFill.Color = hpColor(ratio)

                    drawn = true
                end
            end
        end

        if not drawn then hideESP(o) end
        updateChams(plr, alive and char or nil, isEnemy(plr))
    end

    for plr, o in pairs(espCache) do
        if not plr.Parent then
            for _, d in pairs(o) do pcall(function() d:Remove() end) end
            espCache[plr] = nil
            if hlCache[plr] then
                pcall(function() hlCache[plr]:Destroy() end)
                hlCache[plr] = nil
            end
        end
    end
end

--=====================================================================
-- EXTENDED HITBOX (players + NPCs) + CUBO VISUAL
-- Size + CanCollide reaplicados todo frame, SEM Massless
--=====================================================================
local hitboxCache = {}
local visualCache = {}         -- [model] = cubo visual
local playerCharSet = setmetatable({}, { __mode = "k" })
local npcList = {}
local npcScanTimer = 0
local NPC_SCAN_INTERVAL = 1.0
local NPC_MAX_DISTANCE = 500

local HITBOX_COLOR = Color3.fromRGB(122, 92, 255)

local function getRoot(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.RootPart then return hum.RootPart end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

-- cubo visual (part local, só no seu client)
local function getVisual(model, hrp)
    local v = visualCache[model]
    if not v or v.Parent == nil then
        v = Instance.new("Part")
        v.Name = "UH_HitboxVisual"
        v.Anchored = true
        v.CanCollide = false
        v.CanQuery = false
        v.CanTouch = false
        v.CastShadow = false
        v.Material = Enum.Material.Neon
        v.Color = HITBOX_COLOR
        v.Transparency = 0.6
        v.Parent = Workspace
        visualCache[model] = v
    end
    return v
end

local function hideVisual(model)
    local v = visualCache[model]
    if v then
        pcall(function() v:Destroy() end)
        visualCache[model] = nil
    end
end

local function applyHitbox(char, size)
    local hrp = getRoot(char)
    if not hrp or not hrp:IsA("BasePart") then return end

    local cached = hitboxCache[char]
    if not cached or cached.part ~= hrp then
        hitboxCache[char] = {
            part = hrp,
            size = hrp.Size,
            transparency = hrp.Transparency,
            canCollide = hrp.CanCollide,
        }
        cached = hitboxCache[char]
    end

    -- hit real: expande o HRP (invisível)
    hrp.Size = Vector3.new(size, size, size)
    hrp.CanCollide = false
    hrp.Transparency = 1

    -- visual: cubo neon centralizado no alvo
    if Config.HitboxVisual then
        local v = getVisual(char, hrp)
        v.Size = Vector3.new(size, size, size)
        v.CFrame = hrp.CFrame
    end
end

local function restoreHitbox(char)
    local c = hitboxCache[char]
    if not c then return end
    local p = c.part
    if p and p.Parent then
        p.Size = c.size
        p.Transparency = c.transparency
        p.CanCollide = c.canCollide
    end
    hitboxCache[char] = nil
    hideVisual(char)
end

-- procura NPCs: models com Humanoid que não são de players
local function scanNPCs()
    local myChar = LP.Character
    local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position
    local newNPCs = {}

    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model") and not playerCharSet[model] then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hrp = getRoot(model)
                if hrp then
                    local ok = true
                    if myPos then
                        local d = (hrp.Position - myPos).Magnitude
                        if d > NPC_MAX_DISTANCE then ok = false end
                    end
                    if ok then
                        newNPCs[#newNPCs + 1] = model
                    end
                end
            end
        end
    end

    npcList = newNPCs
end

-- mantém mapa char -> é player (p/ diferenciar NPCs no scan)
local function refreshPlayerChars()
    local set = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then set[plr.Character] = true end
    end
    playerCharSet = set
end

