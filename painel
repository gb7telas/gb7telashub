local fovCircle, fovDot
if Drawing then
    fovCircle = Drawing.new("Circle")
    fovCircle.Thickness = 1.5
    fovCircle.NumSides = 60
    fovCircle.Filled = false
    fovCircle.Transparency = 0.7

    fovDot = Drawing.new("Circle")
    fovDot.Thickness = 1
    fovDot.NumSides = 12
    fovDot.Filled = true
    fovDot.Radius = 2
    fovDot.Transparency = 0.8
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isVisible(part)
    if not Config.VisibleCheck then return true end
    rayParams.FilterDescendantsInstances = { LP.Character }
    local origin = Cam.CFrame.Position
    local res = WS:Raycast(origin, part.Position - origin, rayParams)
    return res == nil or res.Instance:IsDescendantOf(part.Parent)
end

local function candidateChar(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local aimPart = Config.AimHead and (char:FindFirstChild("Head") or getRoot(char)) or getRoot(char)
    return aimPart
end

local function findTarget()
    local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    local best, bestDist = nil, Config.FOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and (not Config.TeamCheck or isEnemy(plr)) then
            local char = plr.Character
            if char then
                local aimPart = candidateChar(char)
                if aimPart then
                    local pos, onScreen = Cam:WorldToViewportPoint(aimPart.Position)
                    if onScreen then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < bestDist and isVisible(aimPart) then
                            best, bestDist = aimPart, d
                        end
                    end
                end
            end
        end
    end

    if Config.AimNPCs then
        for _, model in ipairs(HB.npcs) do
            if model.Parent then
                local aimPart = candidateChar(model)
                if aimPart then
                    local pos, onScreen = Cam:WorldToViewportPoint(aimPart.Position)
                    if onScreen then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < bestDist and isVisible(aimPart) then
                            best, bestDist = aimPart, d
                        end
                    end
                end
            end
        end
    end
    return best
end

local function aimAt(part, dt)
    local target = part.Position
    local hum = getLocalHumanoid()
    if Config.Prediction > 0 and hum then
        local root = getRoot(hum.Parent)
        if root then
            target = target + root.AssemblyLinearVelocity * Config.Prediction
        end
    end
    local goal = CFrame.lookAt(Cam.CFrame.Position, target)
    local alpha = 1 - math.exp(-Config.Smooth * dt)
    Cam.CFrame = Cam.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
end

local function isAiming()
    if not Config.Aimbot then return false end
    if Config.AimToggle then return State.aimToggled end
    return State.keyDown or (Config.AimMouse and State.mouseDown)
end

--=====================================================================
-- INPUT
--=====================================================================
conns[#conns + 1] = UIS.InputBegan:Connect(function(input, gpe)
    if State.listening then return end
    if input.KeyCode == Config.AimKey then
        if Config.AimToggle then
            State.aimToggled = not State.aimToggled
        else
            State.keyDown = true
        end
    end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then State.mouseDown = true end
    if input.KeyCode == Config.SpeedKey then State.speedKeyDown = true end
    if input.KeyCode == Config.ToggleKey and not gpe then toggleUI() end
end)

conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Config.AimKey then State.keyDown = false end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then State.mouseDown = false end
    if input.KeyCode == Config.SpeedKey then State.speedKeyDown = false end
end)

conns[#conns + 1] = WS:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if WS.CurrentCamera then Cam = WS.CurrentCamera end
end)

--=====================================================================
-- LOOP
--=====================================================================
conns[#conns + 1] = RS.RenderStepped:Connect(function(dt)
    if fovCircle then
        local show = Config.Aimbot and Config.ShowFOV
        fovCircle.Visible = show
        fovDot.Visible = show
        if show then
            local c = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
            fovCircle.Position = c
            fovCircle.Radius = Config.FOV
            fovCircle.Color = accent()
            fovDot.Position = c
            fovDot.Color = accent()
        end
    end

    if Drawing then pcall(updateESP) end
    speedStep()

    if isAiming() then
        local t = findTarget()
        if t then aimAt(t, dt) end
    end
end)

applyTheme()

