local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function getAimPart(char)
    local part = char:FindFirstChild(Config.AimPart)
    if part and part:IsA("BasePart") then return part end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.RootPart then return hum.RootPart end
    return char:FindFirstChildWhichIsA("BasePart")
end

local function isVisible(part, char)
    if not LP.Character then return true end
    rayParams.FilterDescendantsInstances = { LP.Character }
    local origin = Camera.CFrame.Position
    local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
    return hit == nil or hit.Instance:IsDescendantOf(char)
end

local function findTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, Config.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local alive, char = getChar(plr)
            if alive and not (Config.TeamCheck and not isEnemy(plr)) then
                local part = getAimPart(char)
                if part then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d <= bestDist and (not Config.VisibleCheck or isVisible(part, char)) then
                            best, bestDist = part, d
                        end
                    end
                end
            end
        end
    end
    return best
end

local function aimAt(part, dt)
    local origin = Camera.CFrame.Position
    local target = part.Position
    if Config.Prediction > 0 then
        target = target + part.AssemblyLinearVelocity * Config.Prediction
    end
    local goal = CFrame.lookAt(origin, target)
    local alpha = math.clamp(dt * Config.Smoothness, 0.03, 1)
    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end

