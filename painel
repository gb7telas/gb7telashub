local function createToggle(parent, text, default, changed, key)
    local row = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Colors.Surface,
        AutoButtonColor = false, Text = "", BorderSizePixel = 0,
    }, parent)
    corner(row, 8)
    create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = text, TextColor3 = Colors.Text,
        Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local track = create("Frame", {
        Size = UDim2.fromOffset(36, 18), Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = Colors.Surface2, BorderSizePixel = 0,
    }, row)
    corner(track, 9)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Colors.Text, BorderSizePixel = 0,
    }, track)
    corner(knob, 7)

    local state = default and true or false
    local function render(anim)
        local kp = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        local tc = state and accent() or Colors.Surface2
        if anim then
            tween(knob, { Position = kp }, 0.15)
            tween(track, { BackgroundColor3 = tc }, 0.15)
        else
            knob.Position = kp
            track.BackgroundColor3 = tc
        end
    end

    local api = {}
    function api.Set(v, fire)
        state = v and true or false
        render(true)
        if fire ~= false and changed then changed(state) end
    end
    function api.Get() return state end
    function api.Refresh() render(false) end

    render(false)
    if key then Refs[key] = api end
    onTheme(function() render(false) end)

    row.MouseButton1Click:Connect(function() api.Set(not state, true) end)
    row.MouseEnter:Connect(function() tween(row, { BackgroundColor3 = Colors.Surface2 }, 0.15) end)
    row.MouseLeave:Connect(function() tween(row, { BackgroundColor3 = Colors.Surface }, 0.15) end)
    return api
end

local function createSlider(parent, text, min, max, default, suffix, changed, key)
