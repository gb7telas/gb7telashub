        BackgroundTransparency = 1, Text = text, TextColor3 = Colors.Text,
        Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local btn = create("TextButton", {
        Size = UDim2.fromOffset(130, 24), Position = UDim2.new(1, -140, 0.5, -12),
        BackgroundColor3 = Colors.Surface2, Text = default, TextColor3 = Colors.Text,
        Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = false,
    }, row)
    corner(btn, 6)

    local popup = create("Frame", {
        Size = UDim2.fromOffset(130, #options * 26 + 8), BackgroundColor3 = Colors.Surface,
        BorderSizePixel = 0, Visible = false, ZIndex = 20,
    }, gui)
    corner(popup, 8)
    stroke(popup, Colors.Stroke)
    local pl = Instance.new("UIListLayout")
    pl.Padding = UDim.new(0, 2)
    pl.Parent = popup
    local pp = Instance.new("UIPadding")
    pp.PaddingTop = UDim.new(0, 4)
    pp.PaddingLeft = UDim.new(0, 4)
    pp.PaddingRight = UDim.new(0, 4)
    pp.Parent = popup
    openPopups[#openPopups + 1] = popup

    local api = {}
    local function close()
        popup.Visible = false
    end

    for _, opt in ipairs(options) do
        local ob = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Colors.Surface,
            Text = opt, TextColor3 = Colors.Text, Font = Enum.Font.GothamMedium,
            TextSize = 12, AutoButtonColor = false,
        }, popup)
        corner(ob, 5)
        -- bolinha de cor nos presets
        if Presets[opt] then
            local dot = create("Frame", {
                Size = UDim2.fromOffset(10, 10), Position = UDim2.new(0, 6, 0.5, -5),
                BackgroundColor3 = Presets[opt], BorderSizePixel = 0,
            }, ob)
            corner(dot, 5)
            ob.TextXAlignment = Enum.TextXAlignment.Right
            ob.Text = opt .. "  "
        end
        ob.MouseEnter:Connect(function() tween(ob, { BackgroundColor3 = Colors.Surface2 }, 0.12) end)
        ob.MouseLeave:Connect(function() tween(ob, { BackgroundColor3 = Colors.Surface }, 0.12) end)
        ob.MouseButton1Click:Connect(function()
            btn.Text = opt
            close()
            if changed then changed(opt) end
        end)
    end

    btn.MouseButton1Click:Connect(function()
        if popup.Visible then
            close()
        else
            for _, p in ipairs(openPopups) do p.Visible = false end
            popup.Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4)
            popup.Visible = true
        end
    end)

    function api.Set(v, fire)
        btn.Text = v
        if fire ~= false and changed then changed(v) end
    end
    function api.Get() return btn.Text end
    if key then Refs[key] = api end
    return api
end

